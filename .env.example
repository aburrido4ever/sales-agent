# Copy to .env.local (gitignored) and fill in real values.

# ElevenLabs natural-voice TTS for AISA (briefing + debrief). Leave empty to keep the
# Web Speech API fallback. Get a key at https://elevenlabs.io/app/settings/api-keys.
VITE_ELEVENLABS_API_KEY=

# Optional: a specific ElevenLabs voice id. Leave empty to use the default "Rachel" voice.
VITE_ELEVENLABS_VOICE_ID=
